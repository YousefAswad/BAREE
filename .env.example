APP_NAME=BAREE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# PostgreSQL is required in production for row-level security. Use a NON-owner role for the app.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=baree
DB_USERNAME=baree_app
DB_PASSWORD=change-me

SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=baree
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=baree
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me

# AI providers (platform keys). Institutions can add their own keys in the admin portal.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_STANDARD=claude-sonnet-5-5
ANTHROPIC_MODEL_LIGHT=claude-haiku-5-5
ANTHROPIC_MODEL_ADVANCED=claude-opus-5-5
OPENAI_API_KEY=
# Set to model IDs available on your OpenAI account
OPENAI_MODEL_STANDARD=
OPENAI_MODEL_LIGHT=
OPENROUTER_API_KEY=

BAREE_PRIVACY_MODE=consent

# Phase 3: studio
BAREE_AV_SCANNER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
GOTENBERG_URL=http://127.0.0.1:3000

# Media providers (set the models available on your accounts)
MEDIA_IMAGE_DRIVER=openai
OPENAI_IMAGE_MODEL=
MEDIA_SPEECH_DRIVER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
OPENAI_TTS_MODEL=
MEDIA_VIDEO_DRIVER=fake
VIDEO_SUBMIT_URL=
VIDEO_STATUS_URL=
VIDEO_API_KEY=
VIDEO_RESULT_HOSTS=
MEDIA_3D_DRIVER=fake
MODEL3D_SUBMIT_URL=
MODEL3D_STATUS_URL=
MODEL3D_API_KEY=
MODEL3D_RESULT_HOSTS=
MEDIA_MODERATION_DRIVER=openai

# Phase 4: knowledge hub (embeddings) — pgvector column size must match EMBEDDINGS_DIMENSIONS
EMBEDDINGS_DRIVER=openai
EMBEDDINGS_MODEL=
EMBEDDINGS_DIMENSIONS=1536

# Phase 5: billing
BILLING_PROVIDER=manual
BILLING_INVOICE_PREFIX=BAREE
BILLING_TAX_PERCENT=0
BILLING_BANK_INSTRUCTIONS=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
HMAC_GATEWAY_CHECKOUT_URL=
HMAC_GATEWAY_SECRET=

# Phase 5: WhatsApp Business Platform (Cloud API)
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_OTP=baree_otp
WHATSAPP_TEMPLATE_ASSIGNMENT=baree_assignment
WHATSAPP_TEMPLATE_REMINDER=baree_reminder
